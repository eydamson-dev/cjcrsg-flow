generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Application entities are introduced with the MVP that owns them.

// MVP 2 — Template Management.
// A local cache of the user's Canva brand templates and their Autofill fields,
// refreshed by an explicit sync. Canva remains the source of truth for the
// template definition; the application stores references by Canva identifier.
model Template {
  id                  String          @id @default(cuid())
  canvaId             String          @unique
  title               String
  thumbnailKey        String?
  thumbnailContentType String?
  viewUrl             String?
  createUrl           String?
  canvaCreatedAt      DateTime?
  canvaUpdatedAt      DateTime?
  syncedAt            DateTime        @default(now())
  fields              TemplateField[]
  contents            Content[]

  @@map("templates")
}

model TemplateField {
  id         String   @id @default(cuid())
  templateId String
  name       String
  type       String
  position   Int      @default(0)
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, name])
  @@map("template_fields")
}

// MVP 3 — Content Creation & Management.
// Application-owned records for content created from Canva templates.
//
// Content is self-contained: template provenance and field definitions are
// snapshotted at creation so records survive template-cache pruning (sync
// deletes unused cache rows) and can be rendered/validated without joining
// the mutable template cache. The FK is nullable + SetNull for the same
// reason; templateCanvaId is the durable Canva reference used for Autofill.
model Content {
  id     String        @id @default(cuid())
  status ContentStatus @default(UNFINISHED)
  // Template provenance (snapshot at creation; does not auto-refresh on re-sync).
  templateId      String?
  templateCanvaId String
  templateTitle   String
  templateFields  Json // [{ name, type, position }]
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  // Submitted field values keyed by field name. Shape mirrors Canva's
  // DatasetValue: { [name]: { type: "text", text } | { type: "image", assetId } }.
  fieldValues Json @default("{}")

  // Generated design reference. Replaced on a successful regeneration, kept on
  // a failed one (do not destroy working output).
  designId             String?
  editUrl              String?
  viewUrl              String?
  thumbnailKey         String?
  thumbnailContentType String?

  // Latest Autofill job. Status is Canva-owned -> free-form string.
  autofillJobId   String?
  autofillStatus  String? // "in_progress" | "success" | "failed" | null
  autofillError   Json?   // { code, message } when failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets ContentAsset[]
  publications Publication[]

  @@index([templateId])
  @@index([status, updatedAt])
  @@map("contents")
}

enum ContentStatus {
  UNFINISHED
  DRAFT
  READY
}

// Locally retained copies of images uploaded for image-typed fields, so the
// editor can re-render a previously chosen image after a reload. fieldValues
// itself stays a pure DatasetValue mirror (asset_id only).
model ContentAsset {
  id          String  @id @default(cuid())
  contentId   String
  fieldName   String
  storageKey  String
  contentType String
  content     Content @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([contentId, fieldName])
  @@map("content_assets")
}

// MVP 4 — Facebook Publishing.
//
// The connected Facebook Page. Private single-user app: the Page access token
// is long-lived and does not expire (verified against Meta Graph v26.0), so it
// is persisted here so publishing survives backend restarts. Tokens are never
// exposed through the API or the frontend.
model FacebookPage {
  id          String   @id @default(cuid())
  pageId      String   @unique
  name        String
  accessToken String
  category    String?
  tasks       Json?
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  publications Publication[]

  @@map("facebook_pages")
}

enum PublicationStatus {
  PUBLISHING
  PUBLISHED
  FAILED
}

// One publish attempt of a Content to a Facebook Page. Append-only: a Content
// may have many Publications (retry after failure, intentional re-publish), so
// history is never overwritten. The Content stays READY; the publication
// lifecycle lives here. The target Page is stored as an FK plus a snapshot so
// history survives a Page disconnect (mirrors Content's template snapshot).
model Publication {
  id        String            @id @default(cuid())
  contentId String
  content   Content           @relation(fields: [contentId], references: [id], onDelete: Cascade)
  status    PublicationStatus

  facebookPageRecordId String?
  facebookPage         FacebookPage? @relation(fields: [facebookPageRecordId], references: [id], onDelete: SetNull)
  facebookPageId       String
  facebookPageName     String

  // Publishing metadata (separate from Canva design fields).
  caption String?

  // Media provenance: the exact design/export used for this attempt.
  designId         String?
  mediaKey         String?
  mediaContentType String?

  // Meta result (where available).
  facebookPostId  String?
  facebookPhotoId String?
  publishedAt     DateTime?

  // Structured failure (Meta error object, or a synthetic export error).
  errorCode    Int?
  errorSubcode Int?
  errorMessage String?
  fbtraceId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contentId, createdAt])
  @@index([status])
  @@index([facebookPageRecordId])
  @@map("publications")
}
